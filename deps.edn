{:deps {org.clojure/clojure {:mvn/version "1.12.2"}
        metosin/reitit-spec {:mvn/version "0.9.1"}
        metosin/reitit-core {:mvn/version "0.9.1"}
        metosin/malli {:mvn/version "0.19.1"}}
 :paths ["src/cljc" "resources"]
 :aliases {:backend
           {:extra-paths ["src/clj"]
            :extra-deps {metosin/reitit-ring {:mvn/version "0.9.1"}
                         cheshire/cheshire {:mvn/version "6.1.0"}
                         buddy/buddy-hashers {:mvn/version "2.0.167"}
                         buddy/buddy-sign {:mvn/version "3.6.1-359"}
                         metosin/reitit-malli {:mvn/version "0.9.1"}
                         metosin/reitit-middleware {:mvn/version "0.9.1"}
                         metosin/reitit-swagger {:mvn/version "0.9.1"}
                         metosin/reitit-swagger-ui {:mvn/version "0.9.1"}
                         aero/aero {:mvn/version "1.1.6"}
                         integrant/integrant {:mvn/version "1.0.0-RC2"}
                         integrant/repl {:mvn/version "0.4.0"}
                         org.postgresql/postgresql {:mvn/version "42.7.7"}
                         com.github.seancorfield/next.jdbc {:mvn/version "1.3.9999-SNAPSHOT"}
                         hiccup/hiccup {:mvn/version "2.0.0-RC3"}
                         ring/ring-anti-forgery {:mvn/version "1.4.0"}
                         ring-cors/ring-cors {:mvn/version "0.1.13"}
                         ;; Honeysql
                         ;; Hugsql
                         hikari-cp/hikari-cp {:mvn/version "3.3.0"}
                         migratus/migratus {:mvn/version "1.6.4"}
                         ring/ring-jetty-adapter {:mvn/version "1.15.0-beta2"}
                         metosin/ring-swagger-ui {:mvn/version "5.20.0"}
                         metosin/ring-http-response {:mvn/version "0.9.5"}
                         metosin/muuntaja {:mvn/version "0.6.11"}
                         camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
                         ch.qos.logback/logback-classic {:mvn/version "1.5.18"}
                         ;; Add the logging wrappers for log APIs that are used by the Java libs
                         ;; you need. Some of these might require some initializion calls.
                         ;; org.apache.logging.log4j/log4j-to-slf4j {:mvn/version "2.23.1"}
                         ;; org.slf4j/jul-to-slf4j {:mvn/version "2.0.16"}
                         ;; org.slf4j/jcl-over-slf4j {:mvn/version "2.0.16"}
                         org.clojure/tools.logging {:mvn/version "1.3.0"}}}

           :dev
           ;; Include test folder here for REPL,
           ;; using test alias with iced command would also apply main-opts
           {:extra-paths ["dev/clj" "target/dev"]}

           :repl
           {:extra-deps {;; Need 1.2+ for Java 20+ interrupt
                         nrepl/nrepl {:mvn/version "1.3.1"}
                         cider/cider-nrepl {:mvn/version "0.47.1"}}
            :main-opts ["-m" "nrepl.cmdline"
                        "--middleware" "[cider.nrepl/cider-middleware]"
                        "--interactive"]
            :jvm-opts [;; https://www.metosin.fi/blog/missing-stacktraces
                       "-XX:-OmitStackTraceInFastThrow"
                       ;; To allow nrepl interrupt threads on Java 20+
                       "-Djdk.attach.allowAttachSelf"
                       "-XX:+EnableDynamicAgentLoading"]}

           ;; Frontend
           :frontend
           {:extra-paths ["src/cljs" "src/js" "test/cljs"]
            :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}
                         metosin/reitit-frontend {:mvn/version "0.9.1"}
                         com.pitch/uix.core {:mvn/version "1.4.4"}
                         com.pitch/uix.dom {:mvn/version "1.4.4"}
                         re-frame/re-frame {:mvn/version "1.4.3"}
                         superstructor/re-frame-fetch-fx {:mvn/version "0.4.0"}
                         metosin/reagent-dev-tools {:mvn/version "1.0.3"}
                         com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}

           :shadow-cljs
           {:extra-paths ["dev/cljs"]
            :extra-deps {thheller/shadow-cljs {:mvn/version "3.2.0"}
                         binaryage/devtools {:mvn/version "1.0.7"}
                         org.slf4j/slf4j-simple {:mvn/version "2.1.0-alpha1"}}}

           :build
           {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
            :ns-default build}

           :outdated
           {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}
                   org.slf4j/slf4j-simple {:mvn/version "2.1.0-alpha1"}}
            :main-opts ["-m" "antq.core"]}

           :kaocha
           {:extra-paths ["src/clj" "test/clj" "test/cljc"]
            :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                         ring/ring-mock {:mvn/version "0.6.2"}
                         org.clojure/test.check {:mvn/version "1.1.1"}}
            :main-opts ["-m" "kaocha.runner"]}

           :backend:test
           {:extra-paths ["test/clj" "test/cljc"]
            :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                         ring/ring-mock {:mvn/version "0.6.2"}
                         org.clojure/test.check {:mvn/version "1.1.1"}}
            :main-opts ["-m" "kaocha.runner"]}

           :kondo
           {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.07.28"}}
            :main-opts ["-m" "clj-kondo.main"]}

           :eastwood
           {:extra-deps {jonase/eastwood {:mvn/version "1.4.3"}}
            :main-opts ["-m" "eastwood.lint"]}}}
