        "daisyui": "5.0.54",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "react-refresh": "0.17.0",
        "shadow-cljs": "3.2.0",
        "tailwindcss": "4.1.12"
    },
    "dependencies": {
        "@js-joda/core": "5.6.3",
        "lucide-react": "0.542.0",
