{
    "name": "template_frontend",
    "scripts": {
        "css:dev": "tailwindcss -i ./resources/public/css/main.css -o ./target/dev/public/css/main.css --watch",
        "css:build": "tailwindcss -i ./resources/public/css/main.css -o ./target/release/public/css/main.css --minify",
        "dev": "npm run css:dev & shadow-cljs watch app",
        "release": "npm run css:build && shadow-cljs release app"
    },
    "devDependencies": {
        "@babel/cli": "^7.25.0",
        "@babel/core": "^7.25.0",
        "@babel/plugin-transform-react-jsx": "^7.25.0",
        "react-refresh": "0.17.0",
        "shadow-cljs": "3.2.0",
        "tailwindcss": "4.1.12",
        "daisyui": "5.0.54",
        "postcss": "8.5.6",
        "autoprefixer": "10.4.21"
    },
    "dependencies": {
        "lucide-react": "^0.469.0",
        "@js-joda/core": "^5.6.3",
        "react": "19.1.1",
        "react-dom": "19.1.1"
    }
}